+    const nx=[['حساب','کلید','مانده پایان سال رسیدگی','افزایش ناخالص','کاهش ناخالص','تسویه حداقل','تسویه حداکثر','باقی‌مانده حداقل','باقی‌مانده حداکثر']];
+    ks.forEach(k=>{ const n=k.next; if(n&&n.settled) nx.push([k.title,k.key,N(k.end),N(n.inc),N(n.dec),N(n.settled.min),N(n.settled.max),N(n.remaining.min),N(n.remaining.max)]); });
