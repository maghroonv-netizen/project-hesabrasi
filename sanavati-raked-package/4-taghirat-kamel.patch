+  R.cuts.forEach((c,i)=>{
+    const rows=[['حساب','کلید','مانده پایان','سمت','تاریخ مرز','قدیمی‌تر از مرز حداقل','حداکثر','حداکثر بدون فرض','وضعیت فعالیت','آخرین گردش قطعی','آخرین گردش محتمل','آخرین افزایش']];
+    ks.forEach(k=>{ const s=k.stale[i], a=k.activity[i]; rows.push([k.title,k.key,N(k.end),side(k.endSide),D(c.cut),N(s.min),N(s.max),N(s.modelFreeMax),ACT_LABEL[a.status],a.lastFull?D(a.lastFull.day):'',a.lastPossible?D(a.lastPossible.day):'',D(k.lastIncrease)]); });
+    XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(rows),'راکد '+c.T+' ماه');
