+  ${L.map(x=>`<tr><td>${fmtD(x.day)}</td><td>${x.early===x.late?'—':fmtD(x.early)+' تا '+fmtD(x.late)}</td><td>${fmtB(x.size)}</td><td>${side(x.side)}</td><td>${ORIG[x.origin]||x.origin}</td></tr>`).join('')}</tbody></table>`;
